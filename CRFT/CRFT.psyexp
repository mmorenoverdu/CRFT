        <Param val="True" valType="bool" updates="constant" name="syncScreenRefresh"/>
      </KeyboardComponent>
    </Routine>
    <CounterbalanceRoutine name="counterbalance">
      <Param name="conditionsFile" updates="None" val="" valType="file"/>
      <Param name="conditionsVariable" updates="None" val="" valType="code"/>
      <Param name="disabled" updates="None" val="False" valType="bool"/>
      <Param name="endExperimentOnDepletion" updates="None" val="True" valType="code"/>
      <Param name="nGroups" updates="None" val="2" valType="code"/>
      <Param name="nReps" updates="None" val="80" valType="code"/>
      <Param name="nSlots" updates="None" val="1" valType="code"/>
      <Param name="name" updates="None" val="counterbalance" valType="code"/>
      <Param name="saveData" updates="None" val="True" valType="bool"/>
      <Param name="saveRemaining" updates="None" val="True" valType="bool"/>
      <Param name="specMode" updates="None" val="uniform" valType="str"/>
    </CounterbalanceRoutine>
  </Routines>
  <Flow>
    <CounterbalanceRoutine name="counterbalance"/>
    <Routine name="exp_settings"/>
    <LoopInitiator loopType="TrialHandler" name="language_loop">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[{'language': 'English', 'ISO_code': 'EN'}, {'language': 'Spanish', 'ISO_code': 'ES'}, {'language': 'French', 'ISO_code': 'FR'}, {'language': 'German', 'ISO_code': 'DE'}]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="language_localiser.xlsx" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="False" valType="bool"/>
      <Param name="loopType" updates="None" val="sequential" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="num"/>
      <Param name="name" updates="None" val="language_loop" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="language_settings"/>
    <LoopTerminator name="language_loop"/>
    <Routine name="welcome"/>
    <Routine name="introduction"/>
    <LoopInitiator loopType="TrialHandler" name="test_loop">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="None" valType="str"/>
      <Param name="conditionsFile" updates="None" val="" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="random" valType="str"/>
      <Param name="nReps" updates="None" val="practice_taps" valType="num"/>
      <Param name="name" updates="None" val="test_loop" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="test_screen"/>
    <LoopTerminator name="test_loop"/>
    <Routine name="fb_test"/>
    <LoopInitiator loopType="TrialHandler" name="blocks_loop">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="None" valType="str"/>
      <Param name="conditionsFile" updates="None" val="" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="False" valType="bool"/>
      <Param name="loopType" updates="None" val="sequential" valType="str"/>
      <Param name="nReps" updates="None" val="n_blocks" valType="num"/>
      <Param name="name" updates="None" val="blocks_loop" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="start_block"/>
    <LoopInitiator loopType="TrialHandler" name="comp_check_loop">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="None" valType="str"/>
      <Param name="conditionsFile" updates="None" val="" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="False" valType="bool"/>
      <Param name="loopType" updates="None" val="sequential" valType="str"/>
      <Param name="nReps" updates="None" val="show_inst" valType="num"/>
      <Param name="name" updates="None" val="comp_check_loop" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <LoopInitiator loopType="TrialHandler" name="instructions_loop">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[{'inst_pics': 'images/task_setup.png', 'image_w': 0.6, 'image_h': 0.5, 'image_x': 0, 'image_y': -0.25, 'text_x': 0, 'text_y': 0.2, 'video': 'no', 'inst_msg_EN': 'Here you see a symbolic representation of the task to be completed in this block.\nThe task consists of two parts:\n\n1. Alternately tap the red circle and one of the five gray circles using the stylus.\nWork your way through the gray circles from left to right, and start and end with the red circle.\nIt is important that you comply WITH THIS SPECIFIED ORDER.\n\n2. SIMULTANEOUSLY with each tap, press the SPACE bar with the index finger of your other hand.\nMake sure to press the space bar all the way down.\n', 'inst_msg_ES': 's'}, {'inst_pics': 'images/stylus_exe.png', 'image_w': 0.5, 'image_h': 0.1, 'image_x': 0, 'image_y': -0.25, 'text_x': 0, 'text_y': 0, 'video': 'no', 'inst_msg_EN': 'It is important that you actually hit the circles with the stylus. As in the task before, it does not matter where exactly you hit the circles (e.g., in the middle or at the edge).\n\nTry to perform the movements as QUICKLY and ACCURATELY as possible.\n\nBoth the time and the accuracy (actually hitting the circles), together with the simultaneous key press, determine your performance.', 'inst_msg_ES': 's'}, {'inst_pics': 'images/task_setup.png', 'image_w': 0, 'image_h': 0, 'image_x': 0, 'image_y': 0, 'text_x': 0, 'text_y': 0.4, 'video': 'yes', 'inst_msg_EN': 'Please watch this animation that outlines the task in this block', 'inst_msg_ES': 's'}, {'inst_pics': 'images/placeholder.png', 'image_w': 0, 'image_h': 0, 'image_x': 0, 'image_y': 0, 'text_x': 0, 'text_y': 0, 'video': 'no', 'inst_msg_EN': 'As soon as you start the trial, a countdown will appear. You will then already see the circles you are supposed to tap. The size of the gray circles may vary from trial to trial.\n\nBegin promptly as soon as the countdown has disappeared.', 'inst_msg_ES': 's'}, {'inst_pics': 'images/placeholder.png', 'image_w': 0, 'image_h': 0, 'image_x': 0, 'image_y': 0, 'text_x': 0, 'text_y': 0, 'video': 'no', 'inst_msg_EN': &quot;During the task, KEEP the hand you're tapping with on the stylus, and keep the index finger of your other hand on the space bar.\n\nDO NOT CORRECT your taps: \nIf you miss a circle, just continue right away!\n\nALWAYS LIFT the stylus off the screen after each tap!\n(do not drag the stylus across the screen)\n\nReminder: Use the stylus with your PREFERRED hand and do not rest your hand on the screen.\nPress the space bar with the index finger of your spare hand.&quot;, 'inst_msg_ES': 's'}]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="$inst_file" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="False" valType="bool"/>
      <Param name="loopType" updates="None" val="sequential" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="num"/>
      <Param name="name" updates="None" val="instructions_loop" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="instructions"/>
    <LoopTerminator name="instructions_loop"/>
    <Routine name="comp_check"/>
    <Routine name="check_fb"/>
    <LoopTerminator name="comp_check_loop"/>
    <Routine name="reminder"/>
    <LoopInitiator loopType="TrialHandler" name="trials_loop">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[{'difficulty_index': 0}, {'difficulty_index': 1}, {'difficulty_index': 2}, {'difficulty_index': 3}, {'difficulty_index': 4}]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="conditions.xlsx" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="random" valType="str"/>
      <Param name="nReps" updates="None" val="reps_per_block" valType="num"/>
      <Param name="name" updates="None" val="trials_loop" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="setup"/>
    <Routine name="countdown"/>
    <Routine name="trial"/>
    <Routine name="blank"/>
    <Routine name="fb"/>
    <LoopTerminator name="trials_loop"/>
    <LoopInitiator loopType="TrialHandler" name="back_forth_loop">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="None" valType="str"/>
      <Param name="conditionsFile" updates="None" val="" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="False" valType="bool"/>
      <Param name="loopType" updates="None" val="sequential" valType="str"/>
      <Param name="nReps" updates="None" val="show_back_forth" valType="num"/>
      <Param name="name" updates="None" val="back_forth_loop" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="controller"/>
    <LoopInitiator loopType="TrialHandler" name="self_assess_loop">
      <Param name="Selected rows" updates="None" val="$str(cur_row)" valType="str"/>
      <Param name="conditions" updates="None" val="[{'self_assess_question_EN': '3. When imagining the movement, what was your use of the VISUAL MODALITY of imagery (creating a visual image of the movement)? Only if you did not use visual imagery at all, select &quot;0&quot;.', 'label_min_EN': 'No visual\nimagery use', 'label_max_EN': 'High visual\nimagery use', 'self_assess_question_ES': 's', 'label_min_ES': 's', 'label_max_ES': 's'}, {'self_assess_question_EN': '4. If you used visual imagery, did you use a FIRST-PERSON PERSPECTIVE (watching the movement through the eyes of the performer, from an internal point of view)? If you selected 0 in the question before, then you must select 0 here as well.', 'label_min_EN': 'No first-person (internal)\nperspective use', 'label_max_EN': 'High first-person (internal)\nperspective use', 'self_assess_question_ES': 's', 'label_min_ES': 's', 'label_max_ES': 's'}, {'self_assess_question_EN': '5. If you used visual imagery, did you use a THIRD-PERSON PERSPECTIVE (watching yourself performing the movement, from an external point of view)? If you selected 0 in the question about general visual imagery use, then you must select 0 here as well.', 'label_min_EN': 'No third-person (external)\nperspective use', 'label_max_EN': 'High third-person (external)\nperspective use', 'self_assess_question_ES': 's', 'label_min_ES': 's', 'label_max_ES': 's'}, {'self_assess_question_EN': '6. When imagining the movement, what was your use of the KINESTHETIC MODALITY of imagery (feeling the sensations of the movement)? Only if you did not use kinesthetic imagery at all, select &quot;0&quot;.', 'label_min_EN': 'No kinesthetic\nimagery use', 'label_max_EN': 'High kinesthetic\nimagery use', 'self_assess_question_ES': 's', 'label_min_ES': 's', 'label_max_ES': 's'}, {'self_assess_question_EN': '1. When imagining the movement, what was the OVERALL VIVIDNESS (considering BOTH the clarity of the image AND the intensity of the sensations)? Only if you did not feel or see anything at all, then select 0.', 'label_min_EN': 'No image at all, you only\n&quot;know&quot; that you were\nthinking of the movement', 'label_max_EN': 'Perfectly clear and vivid as\nnormal vision and/or\nfeel of movement', 'self_assess_question_ES': 's', 'label_min_ES': 's', 'label_max_ES': 's'}, {'self_assess_question_EN': '2. When imagining the movement, did you imagine yourself making errors (e.g. not hitting on the target)? Only if you imagined NO ERRORS in the WHOLE BLOCK, then select 0.', 'label_min_EN': 'No errors, I was\ncompletely accurate\nduring imagery', 'label_max_EN': 'A lot of errors, I was\ncompletely inaccurate\nduring imagery', 'self_assess_question_ES': 's', 'label_min_ES': 's', 'label_max_ES': 's'}, {'self_assess_question_EN': '7. On average, how long was the imagery held?', 'label_min_EN': 'Imagery held for\na very short time', 'label_max_EN': 'Imagery held for\nthe whole time', 'self_assess_question_ES': 's', 'label_min_ES': 's', 'label_max_ES': 's'}, {'self_assess_question_EN': '8. How well did you feel the texture of objects within the imagery?', 'label_min_EN': 'No feeling', 'label_max_EN': 'Very clear feeling', 'self_assess_question_ES': 's', 'label_min_ES': 's', 'label_max_ES': 's'}, {'self_assess_question_EN': '9. How well did you hear the imagery? ', 'label_min_EN': 'No hearing', 'label_max_EN': 'Very clear hearing', 'self_assess_question_ES': 's', 'label_min_ES': 's', 'label_max_ES': 's'}, {'self_assess_question_EN': '10. How easily was an imagery created? ', 'label_min_EN': 'Imagery difficult\nto create', 'label_max_EN': 'Imagery easy\nto create', 'self_assess_question_ES': 's', 'label_min_ES': 's', 'label_max_ES': 's'}, {'self_assess_question_EN': '11. How well could you control the imagery?', 'label_min_EN': 'Unable to\ncontrol imagery', 'label_max_EN': 'Completely able\nto control imagery', 'self_assess_question_ES': 's', 'label_min_ES': 's', 'label_max_ES': 's'}, {'self_assess_question_EN': '12. How quickly was an imagery created? ', 'label_min_EN': 'Imagery slow to create', 'label_max_EN': 'Imagery created quickly', 'self_assess_question_ES': 's', 'label_min_ES': 's', 'label_max_ES': 's'}]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="self_assess_questions.xlsx" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="sequential" valType="str"/>
      <Param name="nReps" updates="None" val="show_self_assess" valType="num"/>
      <Param name="name" updates="None" val="self_assess_loop" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="self_assess"/>
    <LoopTerminator name="self_assess_loop"/>
    <LoopTerminator name="back_forth_loop"/>
    <LoopTerminator name="blocks_loop"/>
    <Routine name="processing"/>
    <Routine name="bye"/>
  </Flow>
</PsychoPy2experiment>
