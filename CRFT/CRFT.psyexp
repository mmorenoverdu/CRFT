        <Param val="if ((inst_file === &quot;instructions_execution.xlsx&quot;)) {&amp;#10;    if (((tickC &amp;&amp; tickF) &amp;&amp; (! (((tickA || tickB) || tickD) || tickE)))) {&amp;#10;        response_correct = true;&amp;#10;    } else {&amp;#10;        response_correct = false;&amp;#10;    }&amp;#10;} else {&amp;#10;    if (((((tickA &amp;&amp; tickB) &amp;&amp; tickE) &amp;&amp; tickF) &amp;&amp; (! (tickC || tickD)))) {&amp;#10;        response_correct = true;&amp;#10;    } else {&amp;#10;        response_correct = false;&amp;#10;    }&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
