        <Param val="if ((response_correct === true)) {&amp;#10;    check_fb_msg = check_correct_msg;&amp;#10;    color_text = &quot;green&quot;;&amp;#10;    corr_incorr_msg = correct_msg;&amp;#10;} else {&amp;#10;    check_fb_msg = check_incorrect_msg;&amp;#10;    color_text = &quot;red&quot;;&amp;#10;    corr_incorr_msg = incorrect_msg;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
