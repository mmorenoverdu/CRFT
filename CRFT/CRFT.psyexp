        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="if ((response_correct === true)) {&amp;#10;    comp_check_loop.finished = true;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="&amp;#10;if response_correct == True:&amp;#10;    comp_check_loop.finished = True" valType="extendedCode" updates="constant" name="End Routine"/>
