    <Param val="Thank you for your patience." valType="str" updates="None" name="End Message"/>
    <Param val="{'participant': '00', 'session': '001', 'language': '[&quot;English&quot;, &quot;French&quot;, &quot;Spanish&quot;]', 'handedness': '[&quot;Right&quot;, &quot;Left&quot;]'}" valType="code" updates="None" name="Experiment info"/>
